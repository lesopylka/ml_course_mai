import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.dummy import DummyClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score, f1_score,
    confusion_matrix, ConfusionMatrixDisplay
)

sns.set_style("whitegrid")
RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

# 1. Загрузка 
df = pd.read_csv("titanic.csv")
print("Размер:", df.shape)
print("Дубликаты:", df.duplicated().sum())
print("\nПропуски:\n", df.isna().sum())
print("\nSurvived:\n", df["Survived"].value_counts(normalize=True).round(3))

# 2.EDA 
fig, axes = plt.subplots(1, 3, figsize=(15, 4))
sns.countplot(x="Survived", data=df, ax=axes[0], palette=["#d62728", "#2ca02c"])
axes[0].set_title("Survived")
sns.barplot(x="Sex", y="Survived", data=df, ax=axes[1], ci=None)
axes[1].set_title("Sex")
sns.barplot(x="Pclass", y="Survived", data=df, ax=axes[2], ci=None)
axes[2].set_title("Pclass")
plt.tight_layout()
plt.show()

print("Выживаемость по полу:\n", df.groupby("Sex")["Survived"].mean().round(3))
print("Выживаемость по классу:\n", df.groupby("Pclass")["Survived"].mean().round(3))

# 3. Подготовка
# Удаляем идентификаторы (утечка)
drop_cols = ["PassengerId", "Name", "Ticket", "Cabin"]
data = df.drop(columns=[c for c in drop_cols if c in df.columns]).copy()

X = data.drop(columns=["Survived"])
y = data["Survived"].astype(int)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y
)

num_cols = ["Age", "SibSp", "Parch", "Fare"]
cat_cols = ["Pclass", "Sex", "Embarked"]

# Для SVM / KNN — со scaler
scaled_prep = ColumnTransformer([
    ("num", Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ]), num_cols),
    ("cat", Pipeline([
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("ohe", OneHotEncoder(handle_unknown="ignore", sparse_output=False))
    ]), cat_cols)
])

# Для деревьев — без scaler
tree_prep = ColumnTransformer([
    ("num", Pipeline([
        ("imputer", SimpleImputer(strategy="median"))
    ]), num_cols),
    ("cat", Pipeline([
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("ohe", OneHotEncoder(handle_unknown="ignore", sparse_output=False))
    ]), cat_cols)
])


# 4. Модели 

models = {
    "Dummy": Pipeline([
        ("prep", tree_prep),
        ("clf", DummyClassifier(strategy="most_frequent", random_state=RANDOM_STATE))
    ]),
    "Decision Tree": Pipeline([
        ("prep", tree_prep),
        ("clf", DecisionTreeClassifier(max_depth=5, min_samples_leaf=10, random_state=RANDOM_STATE))
    ]),
    "Random Forest": Pipeline([
        ("prep", tree_prep),
        ("clf", RandomForestClassifier(
            n_estimators=300, max_depth=8, min_samples_leaf=3,
            random_state=RANDOM_STATE, n_jobs=-1
        ))
    ]),
    "Gradient Boosting": Pipeline([
        ("prep", tree_prep),
        ("clf", GradientBoostingClassifier(
            n_estimators=150, learning_rate=0.05, max_depth=3,
            random_state=RANDOM_STATE
        ))
    ]),
    "SVM": Pipeline([
        ("prep", scaled_prep),
        ("clf", SVC(C=1.0, kernel="rbf", random_state=RANDOM_STATE))
    ]),
    "KNN": Pipeline([
        ("prep", scaled_prep),
        ("clf", KNeighborsClassifier(n_neighbors=7, weights="distance"))
    ]),
}

# 5. Обучение и метрики 

results = []
preds = {}

for name, pipe in models.items():
    pipe.fit(X_train, y_train)
    y_pred = pipe.predict(X_test)
    y_pred_tr = pipe.predict(X_train)
    preds[name] = y_pred

    results.append({
        "Model": name,
        "Train Acc": accuracy_score(y_train, y_pred_tr),
        "Test Acc": accuracy_score(y_test, y_pred),
        "Precision": precision_score(y_test, y_pred, zero_division=0),
        "Recall": recall_score(y_test, y_pred, zero_division=0),
        "F1": f1_score(y_test, y_pred, zero_division=0),
    })

    print(f"\n=== {name} ===")
    print(f"Train Acc: {accuracy_score(y_train, y_pred_tr):.4f}")
    print(f"Test  Acc: {accuracy_score(y_test, y_pred):.4f}")
    print(f"Precision: {precision_score(y_test, y_pred, zero_division=0):.4f}")
    print(f"Recall:    {recall_score(y_test, y_pred, zero_division=0):.4f}")
    print(f"F1:        {f1_score(y_test, y_pred, zero_division=0):.4f}")
    print("CM:\n", confusion_matrix(y_test, y_pred))

    ConfusionMatrixDisplay(
        confusion_matrix(y_test, y_pred),
        display_labels=["Не выжил", "Выжил"]
    ).plot(cmap="Blues")
    plt.title(name)
    plt.show()

summary = pd.DataFrame(results).sort_values("F1", ascending=False)
print("\n=== ИТОГОВАЯ ТАБЛИЦА ===")
print(summary.to_string(index=False, float_format=lambda x: f"{x:.4f}"))

# 6. Feature Importance 
def get_feature_names(prep):
    num_names = num_cols
    ohe = prep.named_transformers_["cat"].named_steps["ohe"]
    cat_names = list(ohe.get_feature_names_out(cat_cols))
    return num_names + cat_names

fig, axes = plt.subplots(1, 3, figsize=(16, 5))
for ax, name in zip(axes, ["Decision Tree", "Random Forest", "Gradient Boosting"]):
    pipe = models[name]
    imp = pipe.named_steps["clf"].feature_importances_
    names = get_feature_names(pipe.named_steps["prep"])
    s = pd.Series(imp, index=names).sort_values()
    s.plot(kind="barh", ax=ax, color="steelblue")
    ax.set_title(name)
plt.tight_layout()
plt.show()

print("\nТоп-5 признаков:")
for name in ["Decision Tree", "Random Forest", "Gradient Boosting"]:
    pipe = models[name]
    imp = pipe.named_steps["clf"].feature_importances_
    names = get_feature_names(pipe.named_steps["prep"])
    s = pd.Series(imp, index=names).sort_values(ascending=False)
    print(f"\n{name}:\n{s.head(5).round(4)}")

# 7. Анализ ошибок лучшей модели 
best_name = summary.iloc[0]["Model"]
print(f"\nЛучшая модель: {best_name}")
y_best = preds[best_name]
cm = confusion_matrix(y_test, y_best)
print("CM:\n", cm)
print(f"FN: {cm[1,0]}, FP: {cm[0,1]}")

err = X_test.copy()
err["y_true"] = y_test.values
err["y_pred"] = y_best
err["error"] = "OK"
err.loc[(err.y_true == 1) & (err.y_pred == 0), "error"] = "FN"
err.loc[(err.y_true == 0) & (err.y_pred == 1), "error"] = "FP"

print("\nОшибки по полу:")
print(pd.crosstab(err["Sex"], err["error"]))
print("\nОшибки по классу:")
print(pd.crosstab(err["Pclass"], err["error"]))

print("\nПримеры FN:")
print(err[err.error == "FN"][["Pclass", "Sex", "Age", "Fare", "y_true", "y_pred"]].head(5))
print("\nПримеры FP:")
print(err[err.error == "FP"][["Pclass", "Sex", "Age", "Fare", "y_true", "y_pred"]].head(5))